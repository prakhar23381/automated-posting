# Copy to .env and fill in the platforms you want to use.
# Any platform left empty is reported as "Credentials not configured".
# See README.md -> "Getting credentials" for how to obtain each value.

# --- Behaviour (optional; defaults shown) ---
LOG_LEVEL=INFO
PLATFORM_TIMEOUT=20
HTTP_TIMEOUT=10
MAX_RETRIES=2
MAX_RETRY_WAIT=5
REPORT_UNCONFIGURED=true
PUBLIC_CHECK_ENABLED=true
PUBLIC_CHECK_TIMEOUT=8
VERIFY_LINK_REACHABLE=false

# --- Telegram: bot token from @BotFather; bot must be an admin of a PUBLIC channel ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=

# --- Mastodon: Preferences -> Development -> New application (scope write:statuses) ---
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# --- Bluesky: Settings -> Privacy and security -> App passwords ---
BLUESKY_SERVICE=https://bsky.social
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# --- GitHub Gist: classic PAT with `gist` scope, or fine-grained PAT with Gists: read and write ---
GITHUB_TOKEN=

# --- Telegraph: run `python scripts/telegraph_account.py "Your Name"` once ---
TELEGRAPH_ACCESS_TOKEN=
TELEGRAPH_AUTHOR_NAME=
TELEGRAPH_AUTHOR_URL=

# --- Dev.to: Settings -> Extensions -> DEV Community API Keys ---
DEVTO_API_KEY=
DEVTO_TAGS=

# --- Hugging Face: write token + a PUBLIC repo you own (space, dataset or model) ---
HF_TOKEN=
HF_REPO_ID=
HF_REPO_TYPE=space

# --- Discord: channel Settings -> Integrations -> Webhooks; guild ID via Developer Mode ---
DISCORD_WEBHOOK_URL=
DISCORD_GUILD_ID=
DISCORD_SERVER_PUBLIC=false
